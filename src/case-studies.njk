---
layout: base.njk
title: Case Studies
permalink: /case-studies/
---
<div class="py-8">
  <div class="max-w-3xl mb-12">
    <span class="text-accent text-sm font-semibold uppercase tracking-wider">Proven Results</span>
    <h1 class="text-3xl md:text-5xl font-heading font-bold text-white mt-2 mb-4">Case Studies</h1>
    <p class="text-lg text-gray-300">
      In-depth breakdowns of real marketing challenges, tactical strategies, and verified business outcomes.
    </p>
  </div>

  <div class="grid md:grid-cols-2 gap-8">
    {% for cs in collections.caseStudies %}
      <article class="p-8 bg-white/5 border border-white/10 rounded-2xl flex flex-col justify-between hover:border-accent/40 transition">
        <div>
          <span class="text-xs font-semibold text-accent uppercase tracking-wider block mb-2">Detailed Case Study</span>
          <h2 class="text-2xl font-heading font-bold text-white mb-3">
            <a href="{{ cs.url }}" class="hover:text-accent transition-colors">
              {{ cs.data.title }}
            </a>
          </h2>
          <p class="text-gray-300 text-sm leading-relaxed mb-6">
            {{ cs.data.excerpt }}
          </p>
        </div>

        <div class="pt-4 border-t border-white/10 flex items-center justify-between">
          <a href="{{ cs.url }}" class="inline-flex items-center gap-2 text-sm font-semibold text-accent hover:text-accent-light transition">
            Read Full Breakdown &rarr;
          </a>
          <span class="text-xs text-gray-500">5 min read</span>
        </div>
      </article>
    {% endfor %}
  </div>
</div>
