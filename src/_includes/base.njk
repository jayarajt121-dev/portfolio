<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title ~ ' | ' if title }}{{ site.title }}</title>
  <meta name="description" content="{{ excerpt or site.description }}" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap" rel="stylesheet">
  <link href="/assets/css/style.css" rel="stylesheet" />
  <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-[#191919] text-gray-200 font-body antialiased min-h-screen flex flex-col selection:bg-[#0FA9E6] selection:text-white">
  {% include "header.njk" %}
  <main class="flex-grow container mx-auto px-4 pt-24 pb-12 max-w-6xl">
    {{ content | safe }}
  </main>
  {% include "footer.njk" %}
</body>
</html>
