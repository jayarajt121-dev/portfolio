<header x-data="{ open: false }" class="fixed top-0 inset-x-0 bg-[#191919]/95 backdrop-blur-md border-b border-white/10 z-50">
  <div class="container mx-auto max-w-6xl flex justify-between items-center px-4 sm:px-6 lg:px-8 py-3">
    <!-- Brand Title -->
    <a href="/" class="text-2xl font-heading font-bold text-accent tracking-tight hover:text-accent-light transition-colors touch-target">
      Jayaraj T
    </a>
    
    <!-- Mobile Hamburger Toggle Button (>= 44px touch target, ARIA compliant) -->
    <button 
      @click="open = !open" 
      :aria-expanded="open" 
      aria-label="Toggle Navigation Menu" 
      class="md:hidden text-gray-300 hover:text-accent focus:outline-none focus:ring-2 focus:ring-accent rounded touch-target justify-center"
    >
      <svg x-show="!open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg x-show="open" style="display: none;" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <!-- Desktop Navigation Bar -->
    <nav class="hidden md:flex items-center space-x-6 text-sm font-medium" aria-label="Main Navigation">
      {% for item in nav %}
        <a href="{{ item.url }}" class="text-gray-300 hover:text-accent-light transition-colors py-1">
          {{ item.label }}
        </a>
      {% endfor %}
      <a href="/contact/" class="touch-target px-4 py-2 text-sm font-semibold text-white bg-accent hover:bg-accent-light rounded-lg transition-colors">
        Hire Me
      </a>
    </nav>
  </div>

  <!-- Mobile Slide-In Navigation Drawer -->
  <div 
    x-show="open" 
    x-transition:enter="transition ease-out duration-200" 
    x-transition:enter-start="opacity-0 -translate-y-4" 
    x-transition:enter-end="opacity-100 translate-y-0" 
    x-transition:leave="transition ease-in duration-150" 
    x-transition:leave-start="opacity-100 translate-y-0" 
    x-transition:leave-end="opacity-0 -translate-y-4" 
    style="display: none;" 
    class="md:hidden border-b border-white/10 bg-[#161616] px-6 py-6 shadow-2xl"
    aria-label="Mobile Navigation Drawer"
  >
    <div class="flex flex-col space-y-1">
      {% for item in nav %}
        <a 
          href="{{ item.url }}" 
          @click="open = false" 
          class="touch-target text-base font-medium text-gray-200 hover:text-accent hover:bg-white/5 px-3 rounded-lg transition-colors"
        >
          {{ item.label }}
        </a>
      {% endfor %}
      <div class="pt-4 mt-2 border-t border-white/10">
        <a 
          href="/contact/" 
          @click="open = false" 
          class="touch-target w-full justify-center px-4 py-2.5 text-sm font-semibold text-white bg-accent hover:bg-accent-light rounded-lg transition-colors shadow-md"
        >
          Let's Discuss a Project
        </a>
      </div>
    </div>
  </div>
</header>
