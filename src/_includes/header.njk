<header x-data="{ open: false }" class="fixed top-0 inset-x-0 bg-[#191919]/90 backdrop-blur-md border-b border-white/10 z-50">
  <div class="container mx-auto max-w-6xl flex justify-between items-center px-4 py-4">
    <a href="/" class="text-2xl font-heading font-bold text-accent tracking-tight hover:text-accent-light transition-colors">
      Jayaraj T
    </a>
    
    <button @click="open = !open" class="md:hidden text-gray-300 hover:text-accent focus:outline-none p-2 rounded" aria-label="Toggle Navigation">
      <svg x-show="!open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg x-show="open" style="display: none;" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>

    <nav :class="{'block': open, 'hidden': !open}" class="hidden md:flex md:items-center space-y-3 md:space-y-0 md:space-x-6 text-sm font-medium absolute md:static top-full left-0 right-0 bg-[#191919] md:bg-transparent border-b md:border-b-0 border-white/10 px-6 py-4 md:p-0">
      {% for item in nav %}
        <a href="{{ item.url }}" @click="open = false" class="block py-1 text-gray-300 hover:text-accent-light transition-colors">
          {{ item.label }}
        </a>
      {% endfor %}
      <a href="/contact/" class="inline-block md:ml-2 px-4 py-2 text-sm font-semibold text-white bg-accent hover:bg-accent-light rounded-lg transition-colors">
        Let's Talk
      </a>
    </nav>
  </div>
</header>
