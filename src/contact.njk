---
layout: base.njk
title: Contact Jayaraj T – Freelance Digital Marketing Inquiries
permalink: /contact/
---
<div class="py-8 md:py-16 reveal-on-scroll max-w-4xl mx-auto">
  <div class="max-w-2xl mb-12">
    <span class="text-accent text-xs font-semibold uppercase tracking-wider block mb-2">Collaboration</span>
    <h1 class="text-3xl md:text-5xl font-heading font-bold text-white mb-4">Contact for Freelance Work</h1>
    <p class="text-lg md:text-xl text-gray-300 font-body leading-relaxed">
      Have a search visibility hurdle, high ad cost bottleneck, or upcoming commercial project? Get in touch to discuss a high-impact freelance collaboration.
    </p>
  </div>

  <div class="grid lg:grid-cols-12 gap-10">
    <!-- Contact Info & Socials (5 Cols) -->
    <div class="lg:col-span-5 space-y-6">
      <div class="p-7 rounded-xl border border-white/10 bg-[#161616] space-y-5">
        <h2 class="font-heading font-bold text-xl text-white">Direct Channels</h2>

        <div>
          <span class="text-xs text-gray-400 uppercase tracking-wide block mb-1">Email Address</span>
          <a href="mailto:jayaraj@example.com" class="text-accent hover:text-accent-light font-medium text-sm transition touch-target">
            jayaraj@example.com
          </a>
        </div>

        <div>
          <span class="text-xs text-gray-400 uppercase tracking-wide block mb-1">Base Location</span>
          <span class="text-sm text-gray-300">Calicut, Kerala, India (IST)</span>
        </div>

        <div>
          <span class="text-xs text-gray-400 uppercase tracking-wide block mb-1">Primary Market Focus</span>
          <span class="text-sm text-gray-300">UAE / GCC & International Commercial Clients</span>
        </div>

        <div>
          <span class="text-xs text-gray-400 uppercase tracking-wide block mb-1">Engagement Model</span>
          <span class="text-sm text-accent font-medium">Freelance Contracts & Advisory</span>
        </div>
      </div>

      <!-- Social Icons (LinkedIn, Twitter) -->
      <div class="p-7 rounded-xl border border-white/10 bg-[#161616] space-y-4">
        <h2 class="font-heading font-bold text-lg text-white">Professional Networks</h2>
        <div class="flex flex-col space-y-2 text-xs">
          <a 
            href="https://linkedin.com/in/jayaraj" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="text-gray-300 hover:text-accent flex items-center gap-2.5 transition touch-target"
          >
            <svg class="w-4 h-4 text-accent" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            <span>Connect on LinkedIn</span>
          </a>
          <a 
            href="https://twitter.com/jayaraj" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="text-gray-300 hover:text-accent flex items-center gap-2.5 transition touch-target"
          >
            <svg class="w-4 h-4 text-accent" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            <span>Follow on Twitter / X</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Simple Email Form with mailto link (7 Cols) -->
    <div class="lg:col-span-7 p-8 rounded-xl border border-white/10 bg-[#161616]" x-data="{ name: '', email: '', projectType: 'Technical SEO Audit', message: '' }">
      <h2 class="font-heading font-bold text-2xl text-white mb-2">Send a Freelance Inquiry</h2>
      <p class="text-xs text-gray-400 mb-6 leading-relaxed">
        Fill out your project details below to automatically generate a structured email consultation request.
      </p>

      <form 
        @submit.prevent="window.location.href = `mailto:jayaraj@example.com?subject=${encodeURIComponent('[Freelance Inquiry] ' + projectType + ' - ' + name)}&body=${encodeURIComponent('Hi Jayaraj,\n\nName: ' + name + '\nEmail: ' + email + '\nProject Scope: ' + projectType + '\n\nDetails:\n' + message)}`"
        class="space-y-4 text-xs"
      >
        <div>
          <label for="name" class="block font-semibold text-gray-300 uppercase tracking-wider mb-2">Your Name</label>
          <input 
            x-model="name"
            id="name" 
            type="text" 
            required 
            placeholder="e.g. John Doe"
            class="w-full px-4 py-3 bg-[#191919] border border-white/15 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-accent text-sm transition touch-target"
          />
        </div>

        <div>
          <label for="email" class="block font-semibold text-gray-300 uppercase tracking-wider mb-2">Business Email</label>
          <input 
            x-model="email"
            id="email" 
            type="email" 
            required 
            placeholder="you@company.com"
            class="w-full px-4 py-3 bg-[#191919] border border-white/15 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-accent text-sm transition touch-target"
          />
        </div>

        <div>
          <label for="projectType" class="block font-semibold text-gray-300 uppercase tracking-wider mb-2">Inquiry Focus</label>
          <select 
            x-model="projectType"
            id="projectType" 
            class="w-full px-4 py-3 bg-[#191919] border border-white/15 rounded-lg text-white text-sm focus:outline-none focus:border-accent transition touch-target"
          >
            <option value="Technical SEO & Crawl Audit">Technical SEO & Crawl Audit</option>
            <option value="Google Ads / Paid Search Restructuring">Google Ads / Paid Search Restructuring</option>
            <option value="Conversion Rate Optimization (CRO)">Conversion Rate Optimization (CRO)</option>
            <option value="Full-Funnel Analytics & GTM Setup">Full-Funnel Analytics & GTM Setup</option>
            <option value="General Freelance Marketing Consultation">General Freelance Marketing Consultation</option>
          </select>
        </div>

        <div>
          <label for="message" class="block font-semibold text-gray-300 uppercase tracking-wider mb-2">Project Scope & Objectives</label>
          <textarea 
            x-model="message"
            id="message" 
            rows="5" 
            required 
            placeholder="Briefly describe your company, target commercial markets, current marketing bottlenecks, and timeline..."
            class="w-full px-4 py-3 bg-[#191919] border border-white/15 rounded-lg text-white placeholder-gray-500 focus:outline-none focus:border-accent text-sm transition"
          ></textarea>
        </div>

        <button 
          type="submit" 
          class="touch-target w-full justify-center px-6 py-3.5 bg-accent hover:bg-accent-light text-white font-semibold rounded-lg shadow-lg hover:shadow-accent/20 transition-all duration-200 text-sm mt-4"
        >
          Generate Mailto Consultation Request &rarr;
        </button>
      </form>
    </div>
  </div>
</div>
