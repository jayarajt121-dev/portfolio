---
layout: base.njk
title: Selected Client Work
permalink: /work/
---
<div class="py-8">
  <div class="max-w-3xl mb-12">
    <span class="text-accent text-sm font-semibold uppercase tracking-wider">Portfolio</span>
    <h1 class="text-3xl md:text-5xl font-heading font-bold text-white mt-2 mb-4">Selected Client Work</h1>
    <p class="text-lg text-gray-300">
      Key clients and multi-channel campaigns managed across the UAE and global markets spanning e-commerce, commercial safety, and logistics.
    </p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
    {% set clients = [
      {
        "name": "Ecomate International LLC",
        "industry": "E‑commerce & Retail",
        "slug": "ecomate-international-llc",
        "summary": "Full-funnel SEO overhaul and Google Ads performance management delivering high-intent organic visitors and reduced acquisition costs.",
        "highlights": "+140% Organic Traffic, -35% CPA",
        "hasCaseStudy": true
      },
      {
        "name": "AITS Safety LLC",
        "industry": "Commercial Safety Services",
        "slug": "aits-safety-llc",
        "summary": "Local SEO dominance across UAE industrial hubs combined with hyper-targeted Google Search lead gen campaigns.",
        "highlights": "+85% Qualified B2B Inquiries",
        "hasCaseStudy": false
      },
      {
        "name": "Starline Security LLC",
        "industry": "Security Services & CCTV",
        "slug": "starline-security-llc",
        "summary": "Search intent optimization for high-ticket commercial installations, optimizing landing page conversion rate.",
        "highlights": "+60% Conversion Rate on Landing Pages",
        "hasCaseStudy": false
      },
      {
        "name": "Digitz Technologies LLC",
        "industry": "Digital Tech Agency (UAE)",
        "slug": "digitz-technologies-llc",
        "summary": "Internal digital marketing operations, client acquisition pipelines, and automated performance tracking across agency accounts.",
        "highlights": "End-to-End Analytics & Tracking Infrastructure",
        "hasCaseStudy": false
      },
      {
        "name": "DMX Global Logistics",
        "industry": "Global Freight & Logistics",
        "slug": "dmx-global-logistics",
        "summary": "International keyword research and B2B freight forwarding search campaigns targeting regional trade corridors.",
        "highlights": "Targeted Lead Gen Across Middle East & Asia",
        "hasCaseStudy": false
      }
    ] %}

    {% for c in clients %}
      <div class="p-6 bg-white/5 border border-white/10 rounded-2xl flex flex-col justify-between hover:border-accent/40 transition">
        <div>
          <span class="inline-block px-2.5 py-1 text-xs font-medium rounded-full bg-accent/10 text-accent mb-3">
            {{ c.industry }}
          </span>
          <h2 class="text-xl font-heading font-bold text-white mb-2">{{ c.name }}</h2>
          <p class="text-sm text-gray-300 mb-4 leading-relaxed">{{ c.summary }}</p>
        </div>

        <div class="pt-4 border-t border-white/10">
          <div class="text-xs text-accent-light font-semibold mb-3">
            Impact: {{ c.highlights }}
          </div>
          {% if c.hasCaseStudy %}
            <a href="/case-studies/{{ c.slug }}/" class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent hover:text-accent-light transition">
              Read Deep-Dive Case Study &rarr;
            </a>
          {% else %}
            <span class="text-xs text-gray-500">Case study writeup in progress</span>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>
