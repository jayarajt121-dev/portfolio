<script>
function kpiDashboard() {
  return {
    kpis: [],
    activeIndex: 0,
    chart: null,
    get currentKpi() {
      return this.kpis[this.activeIndex] || null;
    },
    async init() {
      try {
        const res = await fetch('/data/kpis.json');
        this.kpis = await res.json();
        this.$nextTick(() => {
          this.renderChart();
        });
      } catch (e) {
        console.error("Failed to load KPI data", e);
      }
    },
    selectMetric(index) {
      this.activeIndex = index;
      this.renderChart();
    },
    renderChart() {
      if (!this.kpis.length) return;
      const ctx = document.getElementById('kpiChart');
      if (!ctx) return;
      const current = this.kpis[this.activeIndex];

      if (this.chart) {
        this.chart.destroy();
      }

      this.chart = new Chart(ctx, {
        type: 'line',
        data: {
          labels: current.labels,
          datasets: [{
            label: current.title,
            data: current.values,
            borderColor: '#0FA9E6',
            backgroundColor: 'rgba(15, 169, 230, 0.15)',
            fill: true,
            tension: 0.35,
            borderWidth: 3,
            pointBackgroundColor: '#0FA9E6',
            pointRadius: 5,
            pointHoverRadius: 7
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              labels: { color: '#E5E7EB', font: { family: 'Inter', size: 12 } }
            },
            tooltip: {
              backgroundColor: '#191919',
              borderColor: 'rgba(255,255,255,0.2)',
              borderWidth: 1,
              titleFont: { family: 'Inter' },
              bodyFont: { family: 'Inter' }
            }
          },
          scales: {
            x: {
              grid: { color: 'rgba(255,255,255,0.06)' },
              ticks: { color: '#9CA3AF', font: { family: 'Inter' } }
            },
            y: {
              grid: { color: 'rgba(255,255,255,0.06)' },
              ticks: { color: '#9CA3AF', font: { family: 'Inter' } }
            }
          }
        }
      });
    }
  };
}
</script>
