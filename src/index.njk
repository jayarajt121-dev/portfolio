<!-- KPI Animated Counter & Chart.js Implementation -->
<script>
function kpiWidgetTracker() {
  return {
    widgets: [],
    counters: {},
    chartsLoaded: false,
    async init() {
      try {
        let res;
        try {
          res = await fetch('/portfolio/data/kpis.json');
          if (!res.ok) throw new Error();
        } catch (_) {
          res = await fetch('/data/kpis.json');
        }
        this.widgets = await res.json();
        
        // Initialize counter states at 0
        this.widgets.forEach(w => {
          this.counters[w.id] = 0;
        });

        // Set up IntersectionObserver to trigger counting & chart filling on scroll
        this.$nextTick(() => {
          this.setupScrollTrigger();
        });
      } catch (err) {
        console.error("Failed to fetch KPI data:", err);
      }
    },

    setupScrollTrigger() {
      const section = document.getElementById('kpi-widgets');
      if (!section) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting && !this.chartsLoaded) {
            this.chartsLoaded = true;
            this.animateCounters();
            this.renderHorizontalBarCharts();
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.2 });

      observer.observe(section);
    },

    animateCounters() {
      const duration = 1800; // 1.8 seconds
      const steps = 60;
      const intervalTime = duration / steps;

      this.widgets.forEach(w => {
        const target = w.target;
        const isDecimal = !!w.isDecimal;
        let currentStep = 0;

        const timer = setInterval(() => {
          currentStep++;
          const progress = currentStep / steps;
          // Ease-out cubic
          const easeOut = 1 - Math.pow(1 - progress, 3);
          const currentVal = target * easeOut;

          this.counters[w.id] = isDecimal ? currentVal.toFixed(2) : Math.round(currentVal);

          if (currentStep >= steps) {
            this.counters[w.id] = isDecimal ? target.toFixed(2) : target;
            clearInterval(timer);
          }
        }, intervalTime);
      });
    },

    renderHorizontalBarCharts() {
      this.widgets.forEach(w => {
        const canvasId = 'chart-' + w.id;
        const ctx = document.getElementById(canvasId);
        if (!ctx) return;

        // Chart.js Horizontal Bar Chart (indexAxis: 'y')
        new Chart(ctx, {
          type: 'bar',
          data: {
            labels: w.labels,
            datasets: [{
              label: w.title,
              data: w.values,
              backgroundColor: '#0FA9E6',
              hoverBackgroundColor: '#7FD6FF',
              borderRadius: 4,
              borderSkipped: false,
              barThickness: 12
            }]
          },
          options: {
            indexAxis: 'y', // Required: Horizontal bar chart
            responsive: true,
            maintainAspectRatio: false,
            animation: {
              duration: 1600,
              easing: 'easeOutQuart'
            },
            plugins: {
              legend: { display: false },
              tooltip: {
                backgroundColor: '#141414',
                borderColor: 'rgba(255,255,255,0.2)',
                borderWidth: 1,
                titleColor: '#FFFFFF',
                bodyColor: '#7FD6FF',
                titleFont: { family: 'Inter', size: 12, weight: '600' },
                bodyFont: { family: 'Inter', size: 12 },
                callbacks: {
                  label: function(context) {
                    return `${w.prefix || ''}${context.parsed.x}${w.suffix || ''}`;
                  }
                }
              }
            },
            scales: {
              x: {
                grid: { color: 'rgba(255,255,255,0.06)' },
                ticks: {
                  color: '#9CA3AF',
                  font: { family: 'Inter', size: 10 }
                }
              },
              y: {
                grid: { display: false },
                ticks: {
                  color: '#D1D5DB',
                  font: { family: 'Inter', size: 11, weight: '500' }
                }
              }
            }
          }
        });
      });
    }
  };
}
</script>
